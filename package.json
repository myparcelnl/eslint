{
  "name": "@myparcel-dev/monorepo",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "A collection of ESLint configurations.",
  "repository": "github:myparcelnl/eslint",
  "license": "MIT",
  "author": "Edie Lemoine <edie@myparcel.nl>",
  "scripts": {
    "build": "nx run-many --target=build",
    "clean": "nx run-many --target=clean",
    "prepare": "is-ci || husky install"
  },
  "lint-staged": {
    "*.md": "prettier --write",
    "*.ts": "eslint --fix",
    "package.json": "pnpm dlx sort-package-json"
  },
  "devDependencies": {
    "@myparcel-dev/eslint-config-es6": "workspace:*",
    "@myparcel-dev/eslint-config-esnext": "workspace:*",
    "@myparcel-dev/eslint-config-typescript": "workspace:*",
    "@nx/js": "^23.3.1",
    "@types/eslint": "^8.0.0",
    "@types/node": "^18.14.3",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^6.0.0",
    "eslint": "^8.0.0",
    "husky": "^8.0.0",
    "is-ci": "^3.0.0",
    "lint-staged": "^13.0.0",
    "nx": "^23.3.1",
    "plop": "^3.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.21"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.6",
      "onFail": "download"
    }
  }
}
