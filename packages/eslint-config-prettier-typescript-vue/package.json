{
  "name": "@myparcel-dev/eslint-config-prettier-typescript-vue",
  "version": "1.4.1",
  "keywords": [
    "eslint",
    "eslintconfig",
    "prettier",
    "typescript",
    "vue",
    "vue3"
  ],
  "repository": "github:myparcelnl/eslint",
  "license": "MIT",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.mjs",
    "require": "./index.js"
  },
  "main": "./index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "index.js",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@myparcel-dev/eslint-config-prettier": "workspace:^",
    "@myparcel-dev/eslint-config-typescript-vue": "workspace:^",
    "@vue/eslint-config-typescript": "1 - 11",
    "eslint-plugin-vue": "1 - 9"
  },
  "peerDependencies": {
    "eslint": "7 - 8",
    "prettier": ">= 2"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "build": {},
      "clean": {}
    }
  }
}
